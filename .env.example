# ==============================================================================
# MediKiosk Environment Configuration Template
# Copy this file to .env and adjust values for local development.
# NEVER commit .env with real credentials into source control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DEMO_ENABLED=false

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medikiosk
DB_USERNAME=medikiosk
DB_PASSWORD=medikiosk

# Frontend / CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Future Phase Placeholders (Do NOT configure until relevant phase)
# ==============================================================================

# Security & JWT Configuration
JWT_SECRET=your_jwt_secret_min_256_bits_key_here
JWT_EXPIRATION_MS=86400000

# External Healthcare Integrations (ABDM / HIS / AWS HealthLake)
# ABDM Configuration (Phase 12)
ABDM_MODE=MOCK
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_TIMEOUT_MS=5000
ABDM_ENABLED=true
# HIS Configuration (Phase 13)
HIS_MODE=MOCK
HIS_BASE_URL=https://his.hospital.local/api
HIS_CLIENT_ID=
HIS_CLIENT_SECRET=
HIS_TIMEOUT_MS=5000
HIS_ENABLED=true

# AWS HealthLake Configuration (Phase 14)
HEALTHLAKE_MODE=MOCK
HEALTHLAKE_ENABLED=true
HEALTHLAKE_ENDPOINT=
HEALTHLAKE_DATASTORE_ID=
HEALTHLAKE_REGION=ap-south-1
HEALTHLAKE_TIMEOUT_MS=5000

# AI & Clinical Intelligence Configuration (Phases 20–23)
# Provider options: 'mock' (default offline deterministic reasoner) or 'openrouter' (external LLM)
AI_PROVIDER=mock
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=google/gemini-2.0-flash-001
AI_FAST_MODEL=google/gemini-2.0-flash-001
AI_STRONG_MODEL=anthropic/claude-3.5-sonnet
AI_TIMEOUT_MS=5000
AI_TEMPERATURE=0.2
AI_EXTERNAL_TESTS=false

# Speech & Voice Services
VOICE_PROVIDER=mock
VOICE_STT_ENABLED=true
VOICE_TTS_ENABLED=true
VOICE_MAX_AUDIO_SIZE=10485760
# SPEECH_RECOGNITION_API_KEY=
# TTS_PROVIDER_API_KEY=
